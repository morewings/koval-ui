{
  "name": "koval-ui",
  "homepage": "https://koval.support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morewings/koval-ui.git"
  },
  "bugs": {
    "url": "https://github.com/morewings/koval-ui/issues"
  },
  "license": "MIT",
  "private": false,
  "version": "0.20.9",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/": {
      "import": "./dist/",
      "require": "./dist/"
    }
  },
  "keywords": [
    "react",
    "components-library",
    "css",
    "layout",
    "stylelint",
    "typescript",
    "post-css"
  ],
  "description": "React components collection with minimalistic design. Supports theming, layout, and input validation.",
  "scripts": {
    "dev": "vite",
    "clean:lib": "rm -rf dist",
    "build:lib": "vite build",
    "build": "run-s clean:lib build:lib",
    "lint:code": "eslint src/** --report-unused-disable-directives",
    "fix:code": "run-s 'lint:code --fix'",
    "lint:types": "tsc --pretty --noEmit",
    "convert:theme": "tsx ./convertTheme.ts",
    "lint:commits": "commitlint",
    "lint:style": "stylelint ./src/**/*.css",
    "fix:style": "run-s 'lint:style --fix'",
    "fix:mdx": "prettier ./src/**/*.mdx --write --check",
    "test": "vitest run --config=vitest.config.ts --project=unit",
    "test:storybook": "vitest run --config=vitest.config.ts --project=storybook",
    "test:watch": "vitest watch --config=vitest.config.ts --project=unit",
    "coverage": "run-s 'test --coverage'",
    "preview": "vite preview",
    "start:docs": "storybook dev -p 6006 --no-open",
    "build:docs": "storybook build",
    "generate:component": "npx generate-react-cli component",
    "generate:input": "npx generate-react-cli component --type=input",
    "generate:global": "npx generate-react-cli component --type=global",
    "generate:icon": "npx generate-react-cli component --type=icon --flat",
    "commitlint": "commitlint",
    "semantic-release": "semantic-release",
    "chromatic": "chromatic --exit-zero-on-changes --only-changed",
    "prepare": "is-ci || husky",
    "lint-staged": "lint-staged"
  },
  "peerDependencies": {
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/rubik": "^5.3.0",
    "@material-symbols/svg-700": "^0.45.9",
    "@phosphor-icons/core": "^2.1.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.8",
    "awesome-debounce-promise": "^2.1.0",
    "classnames": "^2.5.1",
    "css-vars-hook": "0.8.4",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/compat": "1.4.1",
    "@eslint/js": "9.39.5",
    "@faker-js/faker": "9.9.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/addon-links": "10.5.4",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "10.5.4",
    "@storybook/builder-vite": "10.5.4",
    "@storybook/icons": "2.1.0",
    "@storybook/react-vite": "10.5.4",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@yelo/rollup-node-external": "1.0.1",
    "alias-kitchen": "0.2.4",
    "chromatic": "18.1.0",
    "commitizen": "4.3.2",
    "commitlint": "21.2.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-ssr-friendly": "1.3.0",
    "eslint-plugin-storybook": "10.5.4",
    "generate-react-cli": "8.4.9",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "is-ci": "4.1.0",
    "lint-staged": "15.5.2",
    "npm-run-all2": "7.0.2",
    "playwright": "1.61.0",
    "postcss": "8.5.18",
    "postcss-preset-env": "10.6.1",
    "prettier": "3.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semantic-release": "25.0.8",
    "storybook": "10.5.4",
    "stylelint": "16.17.0",
    "stylelint-config-standard": "37.0.0",
    "stylelint-order": "8.1.1",
    "stylelint-prettier": "5.0.3",
    "ts-node": "10.9.2",
    "tsx": "4.19.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "unique-names-generator": "4.7.1",
    "vite": "8.1.5",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-svgr": "4.3.0",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  }
}
